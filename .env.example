# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  # server-side only, never expose

# --- Admin (your dad's email) ---
# Any user signing up with this email becomes admin automatically (see 0001_init.sql trigger)
ADMIN_EMAIL=obi.anyanwu@yahoo.com

# --- Cloudflare R2 (S3-compatible object storage) ---
# From Cloudflare dashboard → R2 → Manage API Tokens → Create User API Token (Object Read & Write)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=laser-estate-media
# Public URL prefix. Either https://pub-<hash>.r2.dev  OR  a custom domain like https://media.laserestate.ng
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-YOUR-HASH.r2.dev

# --- Resend (email notifications for inquiries) ---
RESEND_API_KEY=re_xxx
INQUIRY_NOTIFICATION_EMAIL=obi.anyanwu@yahoo.com

# --- WhatsApp (realtor phone in international format, no + or spaces) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=2348033042649

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
